+++ b/src/types/pluginQuota.ts
@@ -0,0 +1,61 @@
+/**
+ * 插件额度（宿主通用额度端点）的展示契约。
+ *
+ * 后端契约（CLIProxyAPI `internal/api/handlers/management/plugin_quota.go`）：
+ * - `GET  /v0/management/quota/providers` → `{ providers: [...] }`
+ * - `POST /v0/management/quota/fetch`     → 直接返回 `pluginapi.QuotaFetchResponse`
+ *
+ * 上游响应可能携带凭据与 PII，这里只保留展示所需字段，禁止直接透传原始对象。
+ */
+
+/** `GET /quota/providers` 中单个提供方，已按 provider key 展平。 */
+export interface PluginQuotaProvider {
+  /** 凭证的 provider key，例如 `cline-pass`。 */
+  provider: string;
+  displayName?: string;
+  supportsReset?: boolean;
+}
+
