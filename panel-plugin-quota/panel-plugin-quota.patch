@@ -0,0 +1,136 @@
+import { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { PluginQuotaMetric, PluginQuotaState } from '@/types';
+import { useNow } from '@/hooks/useNow';
+import { buildResetDisplay, parseIsoToMs } from '@/utils/quota';
+import { QuotaMeter } from '../../components/QuotaMeter';
+import { QuotaResetLabel } from '../../components/QuotaResetLabel';
+import { collectQuotaRowInstants, pickUrgentRowId } from '../../resetSchedule';
+import type { QuotaBodyProps } from '../../types';
+
+/** 宿主原样透传窗口 token，这里只翻译已收录的几个，其余原样展示。 */
+const WINDOW_LABEL_KEYS: Record<string, string> = {
+  five_hour: 'plugin_quota.window_five_hour',
+  weekly: 'plugin_quota.window_weekly',
+  seven_day: 'plugin_quota.window_seven_day',
+  monthly: 'plugin_quota.window_monthly',
+};
+
+const formatMetricValue = (metric: PluginQuotaMetric): string => {
+  if (metric.format === 'currency') {
+    const currency = metric.currency || 'USD';
+    try {
+      return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(metric.value);
+    } catch {
+      // 非 ISO 4217 代码会让 Intl 抛错，退回可读文本而不是整块失败。
+      return `${metric.value} ${currency}`;
+    }
+  }
+  const rounded = Math.round(metric.value * 100) / 100;
+  return metric.unit ? `${rounded} ${metric.unit}` : String(rounded);
+};
+
+/**
+ * 通用插件额度渲染体：只依赖宿主规范化的 groups/buckets/summary 形状，
+ * 因此任何实现 `quota_provider` 的插件都能复用。
+ */
+export function PluginQuotaBody({ quota, classes }: QuotaBodyProps<PluginQuotaState>) {
+  const { t, i18n } = useTranslation();
+  const now = useNow();
+  const data = quota.data;
+
+  const soonestRowId = useMemo(
+    () => pickUrgentRowId(collectQuotaRowInstants('plugin', quota), now),
+    [quota, now]
+  );
+
+  const rows = useMemo(
+    () =>
+      (data?.groups ?? []).flatMap((group, groupIndex) =>
+        group.buckets.map((bucket, index) => ({
+          key: `${groupIndex}-${bucket.window}-${index}`,
+          rowId: bucket.window,
+          labelKey: WINDOW_LABEL_KEYS[bucket.window],
+          fallbackLabel: bucket.window,
+          bucket,
+        }))
+      ),
+    [data]
+  );
+
+  if (!data || rows.length === 0) {
+    return <div className={classes.quotaMessage}>{t('plugin_quota.empty_data')}</div>;
+  }
+
+  const subscription = data.subscription;
+  const showChips = Boolean(subscription?.plan || subscription?.tierName || data.summary.length > 0);
+
+  return (
+    <>
+      {showChips && (
+        <div className={classes.codexPlan}>
+          {subscription?.plan && (
+            <span className={classes.codexPlanItem}>
+              <span className={classes.codexPlanLabel}>{t('plugin_quota.plan')}</span>
+              <span className={classes.codexPlanValue}>{subscription.plan}</span>
+            </span>
+          )}
+          {subscription?.tierName && (
+            <span className={classes.codexPlanItem}>
+              <span className={classes.codexPlanLabel}>{t('plugin_quota.tier')}</span>
+              <span className={classes.codexPlanValue}>{subscription.tierName}</span>
+            </span>
+          )}
+          {data.summary.map((metric) => (
+            <span key={metric.key} className={classes.codexPlanItem}>
+              <span className={classes.codexPlanLabel}>{metric.label}</span>
+              <span className={classes.codexPlanValue}>{formatMetricValue(metric)}</span>
+            </span>
+          ))}
+        </div>
+      )}
+      {rows.map((row, index) => {
+        const remaining = row.bucket.remainingFraction * 100;
+        const resetDisplay = buildResetDisplay(
+          null,
+          parseIsoToMs(row.bucket.resetTime),
+          now,
+          i18n.resolvedLanguage
+        );
+        const label = row.labelKey ? t(row.labelKey) : row.fallbackLabel;
+
+        return (
+          <div key={row.key} className={classes.quotaRow}>
+            <div className={classes.quotaRowHeader}>
+              <span className={classes.quotaModel}>{label}</span>
+              <div className={classes.quotaMeta}>
+                <span className={classes.quotaPercent}>
+                  {t('plugin_quota.remaining', { percent: Number(remaining.toFixed(1)) })}
+                </span>
+                {resetDisplay && (
+                  <QuotaResetLabel
+                    display={resetDisplay}
+                    classes={classes}
+                    soon={row.rowId === soonestRowId}
+                  />
+                )}
+              </div>
+            </div>
+            <div
+              role="meter"
+              aria-label={label}
+              aria-valuemin={0}
+              aria-valuemax={100}
+              aria-valuenow={remaining}
+            >
+              <QuotaMeter percent={remaining} classes={classes} index={index} />
+            </div>
+            {row.bucket.description && (
+              <div className={classes.quotaMessage}>{row.bucket.description}</div>
+            )}
+          </div>
+        );
+      })}
+    </>
+  );
+}
