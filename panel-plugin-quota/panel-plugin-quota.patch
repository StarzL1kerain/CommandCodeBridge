diff --git b/src/services/api/quota.ts b/src/services/api/quota.ts
new file mode 100644
index 0000000..1177f00
--- /dev/null
+++ b/src/services/api/quota.ts
@@ -0,0 +1,196 @@
+/**
+ * 宿主通用额度端点（插件额度）。
+ *
+ * 与其余 quota 适配器的区别：它们直连各厂商自己的 API，这里统一走宿主的
+ * `/v0/management/quota/fetch`，由宿主去问对应插件要数据。因此插件新增
+ * provider 时面板无需改动。
+ */
+
+import { apiClient } from './client';
+import { isRecord } from '@/utils/helpers';
+import type {
+  PluginQuotaBucket,
+  PluginQuotaData,
+  PluginQuotaGroup,
+  PluginQuotaMetric,
+  PluginQuotaProvider,
+  PluginQuotaSubscription,
+} from '@/types';
+
+const asString = (value: unknown): string =>
+  value === undefined || value === null ? '' : String(value);
+
+const firstString = (...values: unknown[]): string => {
+  for (const value of values) {
+    const text = asString(value).trim();
+    if (text) return text;
+  }
+  return '';
+};
+
+const stringList = (value: unknown): string[] =>
+  Array.isArray(value) ? value.map((item) => asString(item).trim()).filter(Boolean) : [];
+
+/**
+ * provider key 可能来自 `supported_providers`（宿主聚合 QuotaDescribeResponse 的形态），
+ * 也可能直接是一个字符串条目。两种都接受，避免绑定未公开的包装结构。
+ */
+const readProviderKeys = (entry: unknown): string[] => {
+  if (typeof entry === 'string') {
+    const key = entry.trim();
+    return key ? [key] : [];
+  }
+  if (!isRecord(entry)) return [];
+
+  const listed = [
+    ...stringList(entry.supported_providers),
+    ...stringList(entry.supportedProviders),
+  ];
+  if (listed.length > 0) return listed;
+
+  const single = firstString(entry.provider, entry.identifier, entry.name);
+  return single ? [single] : [];
+};
+
+export function parsePluginQuotaProviders(payload: unknown): PluginQuotaProvider[] {
+  if (!isRecord(payload)) return [];
+  const entries = Array.isArray(payload.providers) ? payload.providers : [];
+
+  const byProvider = new Map<string, PluginQuotaProvider>();
+  entries.forEach((entry) => {
+    const keys = readProviderKeys(entry);
+    if (keys.length === 0) return;
+
+    const record = isRecord(entry) ? entry : {};
+    const displayName = firstString(record.display_name, record.displayName);
+    const supportsReset = record.supports_reset === true || record.supportsReset === true;
+
+    keys.forEach((provider) => {
+      if (byProvider.has(provider)) return;
+      byProvider.set(provider, {
+        provider,
+        ...(displayName ? { displayName } : {}),
+        ...(supportsReset ? { supportsReset } : {}),
+      });
+    });
+  });
+
+  return Array.from(byProvider.values());
+}
+
+/** 宿主契约是 0~1 的小数，这里只做区间收敛，接受数值与可解析的字符串。 */
+const parseFraction = (value: unknown): number | null => {
+  if (typeof value !== 'number' && typeof value !== 'string') return null;
+  const parsed = typeof value === 'number' ? value : Number(value.trim());
+  if (!Number.isFinite(parsed)) return null;
+  return Math.min(1, Math.max(0, parsed));
+};
+
+const parseBucket = (value: unknown): PluginQuotaBucket | null => {
+  if (!isRecord(value)) return null;
+
+  const remainingFraction = parseFraction(value.remainingFraction ?? value.remaining_fraction);
+  if (remainingFraction === null) return null;
+
+  const bucket: PluginQuotaBucket = {
+    window: firstString(value.window) || 'window',
+    remainingFraction,
+  };
+
+  const description = firstString(value.description);
+  if (description) bucket.description = description;
+
+  const resetTime = firstString(value.resetTime, value.reset_time);
+  if (resetTime) bucket.resetTime = resetTime;
+
+  return bucket;
+};
+
+const parseMetric = (value: unknown): PluginQuotaMetric | null => {
+  if (!isRecord(value)) return null;
+
+  const key = firstString(value.key);
+  const label = firstString(value.label);
+  const raw = typeof value.value === 'number' ? value.value : Number(value.value);
+  if (!key || !label || !Number.isFinite(raw)) return null;
+
+  const metric: PluginQuotaMetric = { key, label, value: raw };
+
+  const unit = firstString(value.unit);
+  if (unit) metric.unit = unit;
+
+  const format = firstString(value.format);
+  if (format === 'number' || format === 'currency') metric.format = format;
+
+  const currency = firstString(value.currency);
+  if (currency) metric.currency = currency;
+
+  return metric;
+};
+
+const parseSubscription = (value: unknown): PluginQuotaSubscription => {
+  const record = isRecord(value) ? value : {};
+  const plan = firstString(record.plan);
+  const tierName = firstString(record.tierName, record.tier_name);
+  const tierId = firstString(record.tierId, record.tier_id);
+  return {
+    ...(plan ? { plan } : {}),
+    ...(tierName ? { tierName } : {}),
+    ...(tierId ? { tierId } : {}),
+  };
+};
+
+const parseServerTimeOffsetMs = (value: unknown): number | undefined => {
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  return undefined;
+};
+
+export function parsePluginQuotaPayload(payload: unknown): PluginQuotaData {
+  const root = isRecord(payload) ? payload : {};
+
+  const groups: PluginQuotaGroup[] = (Array.isArray(root.groups) ? root.groups : [])
+    .map((group): PluginQuotaGroup | null => {
+      if (!isRecord(group)) return null;
+      const buckets = (Array.isArray(group.buckets) ? group.buckets : [])
+        .map((bucket) => parseBucket(bucket))
+        .filter((bucket): bucket is PluginQuotaBucket => bucket !== null);
+      if (buckets.length === 0) return null;
+
+      const displayName = firstString(group.displayName, group.display_name);
+      return { ...(displayName ? { displayName } : {}), buckets };
+    })
+    .filter((group): group is PluginQuotaGroup => group !== null);
+
+  const summary: PluginQuotaMetric[] = (Array.isArray(root.summary) ? root.summary : [])
+    .map((metric) => parseMetric(metric))
+    .filter((metric): metric is PluginQuotaMetric => metric !== null);
+
+  const subscription = parseSubscription(root.subscription);
+  const serverTimeOffsetMs = parseServerTimeOffsetMs(
+    root.serverTimeOffsetMs ?? root.server_time_offset_ms
+  );
+
+  return {
+    groups,
+    summary,
+    ...(Object.keys(subscription).length > 0 ? { subscription } : {}),
+    ...(serverTimeOffsetMs === undefined ? {} : { serverTimeOffsetMs }),
+  };
+}
+
+export const quotaApi = {
+  /** 已注册的额度提供方（含插件）。provider key 用于判断某凭证能否取额度。 */
+  async listProviders(): Promise<PluginQuotaProvider[]> {
+    const data = await apiClient.get('/quota/providers');
+    return parsePluginQuotaProviders(data);
+  },
+
+  /**
+   * 按凭证取额度。provider 与 plugin_id 都由宿主按 auth_index 自行解析，
+   * 面板不需要知道凭证属于哪个插件。
+   */
+  async fetchForCredential(authIndex: string): Promise<PluginQuotaData> {
+    const data = await apiClient.post('/quota/fetch', { auth_index: authIndex });
+    return parsePluginQuotaPayload(data);
+  },
+};
