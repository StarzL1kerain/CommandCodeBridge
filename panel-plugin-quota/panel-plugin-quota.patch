@@ -0,0 +1,45 @@
+/**
+ * 插件额度提供方清单（宿主 `GET /v0/management/quota/providers`）。
+ *
+ * 内置 7 家的额度分支写死在面板里，插件提供方只能在运行时发现。这里缓存一次
+ * 发现结果，供 authFiles 侧判断「这张凭证能不能取额度」，以及把它归入通用适配器。
+ */
+
+import { create } from 'zustand';
+import { quotaApi } from '@/services/api';
+import type { PluginQuotaProvider } from '@/types';
+
+interface PluginQuotaProvidersStoreState {
+  providers: Record<string, PluginQuotaProvider>;
+  loaded: boolean;
+  loading: boolean;
+  error?: string;
+  load: () => Promise<void>;
+}
+
+export const usePluginQuotaProvidersStore = create<PluginQuotaProvidersStoreState>((set, get) => ({
+  providers: {},
+  loaded: false,
+  loading: false,
+  load: async () => {
+    // 失败或空结果同样标记 loaded：宿主没有插件额度时不必每次卡片渲染都重试。
+    if (get().loading || get().loaded) return;
+
+    set({ loading: true });
+    try {
+      const list = await quotaApi.listProviders();
+      const providers: Record<string, PluginQuotaProvider> = {};
+      list.forEach((entry) => {
+        providers[entry.provider] = entry;
+      });
+      set({ providers, loaded: true, loading: false });
+    } catch (err: unknown) {
+      // 不阻塞页面：仅意味着插件额度不展示。
+      set({
+        loading: false,
+        loaded: true,
+        error: err instanceof Error ? err.message : 'unknown error',
+      });
+    }
+  },
+}));
