@@ -0,0 +1,44 @@
+/**
+ * 插件额度数据层：统一走宿主的通用额度端点，不直连厂商 API。
+ *
+ * 这条路径与其余 7 家的区别在于「谁去问上游」：内置 provider 由面板借宿主的
+ * api-call 代理直连厂商接口，插件 provider 由宿主转交给对应插件。因此插件新增
+ * provider 时面板无需改动。
+ *
+ * React-free / SCSS-free —— 由 tests/pluginQuota.test.ts 直接消费。
+ */
+
+import type { TFunction } from 'i18next';
+import type { AuthFileItem, PluginQuotaData, PluginQuotaState } from '@/types';
+import { quotaApi } from '@/services/api';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import { isDisabledAuthFile } from '@/utils/quota';
+import type { QuotaProviderData } from '../types';
+
+const fetchPluginQuota = async (file: AuthFileItem, t: TFunction): Promise<PluginQuotaData> => {
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) {
+    throw new Error(t('plugin_quota.missing_auth_index'));
+  }
+
+  // provider 与 plugin_id 都由宿主按 auth_index 解析，面板不需要知道归属。
+  return quotaApi.fetchForCredential(authIndex);
+};
+
+export const PLUGIN_CONFIG: QuotaProviderData<PluginQuotaState, PluginQuotaData> = {
+  type: 'plugin',
+  i18nPrefix: 'plugin_quota',
+  // 是否真的支持额度由宿主发现结果决定（见 resolveAuthFileQuotaType），
+  // 这里只排除停用凭证。
+  filterFn: (file) => !isDisabledAuthFile(file),
+  fetchQuota: fetchPluginQuota,
+  storeSelector: (state) => state.pluginQuota,
+  storeSetter: 'setPluginQuota',
+  buildLoadingState: () => ({ status: 'loading' }),
+  buildSuccessState: (data) => ({ status: 'success', data }),
+  buildErrorState: (message, status) => ({
+    status: 'error',
+    error: message,
+    errorStatus: status,
+  }),
+};
